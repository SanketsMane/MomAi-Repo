{
  "name": "mom-ai",
  "version": "1.0.0",
  "private": true,
  "description": "MOM AI - Your caring, helpful AI assistant with knowledge base and PDF processing",
  "author": "Sanket Mane",
  "repository": {
    "type": "git",
    "url": "https://github.com/SanketsMane/MomAi-Repo.git"
  },
  "scripts": {
    "build": "turbo build",
    "build:prod": "NODE_ENV=production turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "start:prod": "NODE_ENV=production turbo start",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy": "docker-compose down && docker-compose build && docker-compose up -d",
    "deploy:ec2": "./deploy-ec2.sh production",
    "deploy:logs": "docker-compose logs -f",
    "deploy:stop": "docker-compose down",
    "deploy:restart": "docker-compose restart",
    "deploy:clean": "docker system prune -af && docker volume prune -f",
    "ssl:generate": "openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout nginx/ssl/momdigital.in.key -out nginx/ssl/momdigital.in.crt",
    "ec2:setup": "source ./ec2-commands.sh",
    "ec2:help": "source ./ec2-commands.sh && ec2-help"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.5.1",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@clerk/shared",
      "@sentry/cli",
      "@swc/core",
      "core-js-pure",
      "esbuild",
      "sharp"
    ]
  }
}
